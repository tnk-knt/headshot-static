1:[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@graph\":[{\"@type\":\"Article\",\"headline\":\"AIシステム開発とは？生成AIを業務システムへ組み込む設計・連携・運用の考え方\",\"description\":\"AIを業務システムへ組み込むための設計・連携・運用の考え方を解説します。\",\"datePublished\":\"2026-08-24\",\"dateModified\":\"2026-08-24\",\"mainEntityOfPage\":\"https://headshot.co.jp/insights/ai-system-development/\",\"author\":{\"@type\":\"Organization\",\"name\":\"株式会社HeadShot\",\"url\":\"https://headshot.co.jp/\"},\"publisher\":{\"@type\":\"Organization\",\"name\":\"株式会社HeadShot\",\"url\":\"https://headshot.co.jp/\"}},{\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"トップ\",\"item\":\"https://headshot.co.jp/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"お役立ち情報\",\"item\":\"https://headshot.co.jp/insights/\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"AIシステム開発\",\"item\":\"https://headshot.co.jp/insights/ai-system-development/\"}]}]}"}}],["$","header",null,{"className":"header","children":[["$","a",null,{"className":"logo","href":"/","aria-label":"HeadShot トップ","children":["$","img",null,{"src":"/img/logo_white.png","alt":"株式会社HeadShot"}]}],["$","button",null,{"className":"menu","type":"button","aria-label":"メニューを開く","aria-expanded":"false","aria-controls":"site-navigation","children":"☰"}],["$","nav",null,{"id":"site-navigation","className":"nav","children":[["$","a",null,{"href":"/#about","children":"私たちについて"}],["$","a",null,{"href":"/#services","children":"支援メニュー"}],["$","a",null,{"href":"/insights/","children":"お役立ち情報"}],["$","a",null,{"href":"/#company","children":"会社情報"}],["$","a",null,{"className":"navCta","href":"/services/development/","data-ga-event":"insight_to_service","data-ga-location":"ai_system_navigation","data-ga-service":"development","children":["システム開発を見る ",["$","span",null,{"aria-hidden":"true","children":"→"}]]}]]}]]}],["$","main",null,{"className":"insightPage","children":["$","article",null,{"children":[["$","header",null,{"className":"insightHero","children":[["$","div",null,{"className":"insightBreadcrumb","aria-label":"パンくず","children":[["$","a",null,{"href":"/","children":"トップ"}],["$","span",null,{"aria-hidden":"true","children":"/"}],["$","a",null,{"href":"/insights/","children":"お役立ち情報"}],["$","span",null,{"aria-hidden":"true","children":"/"}],["$","span",null,{"children":"AIシステム開発"}]]}],["$","p",null,{"className":"insightEyebrow","children":"INSIGHT — AI SYSTEM DEVELOPMENT"}],["$","h1",null,{"children":["AIシステム開発とは？",["$","br",null,{}],"生成AIを業務システムへ組み込む設計・連携・運用の考え方"]}],["$","p",null,{"className":"insightLead","children":"AIシステム開発は、既存画面にチャット欄を追加することだけではありません。業務データ、既存システム、権限、人の承認、エラー時の扱いまで含め、AIを業務プロセスの一部として設計する必要があります。発注前に整理しておきたいポイントを実務目線でまとめます。"}],["$","div",null,{"className":"insightMeta","children":[["$","time",null,{"dateTime":"2026-08-24","children":"2026.08.24"}],["$","span",null,{"children":"株式会社HeadShot"}]]}]]}],["$","div",null,{"className":"insightLayout","children":[["$","aside",null,{"className":"insightToc","aria-label":"目次","children":[["$","p",null,{"children":"CONTENTS"}],["$","ol",null,{"children":[["$","li",null,{"children":["$","a",null,{"href":"#definition","children":"AIシステム開発とは"}]}],["$","li",null,{"children":["$","a",null,{"href":"#use-cases","children":"実装パターン"}]}],["$","li",null,{"children":["$","a",null,{"href":"#architecture","children":"設計要素"}]}],["$","li",null,{"children":["$","a",null,{"href":"#integration","children":"既存システム連携"}]}],["$","li",null,{"children":["$","a",null,{"href":"#human","children":"人の承認"}]}],["$","li",null,{"children":["$","a",null,{"href":"#evaluation","children":"評価とテスト"}]}],["$","li",null,{"children":["$","a",null,{"href":"#operations","children":"運用"}]}],["$","li",null,{"children":["$","a",null,{"href":"#vendor","children":"発注前の確認"}]}]]}]]}],["$","div",null,{"className":"insightBody","children":[["$","section",null,{"id":"definition","children":[["$","p",null,{"className":"insightSectionNo","children":"01 — DEFINITION"}],["$","h2",null,{"children":"AIシステム開発は「AI機能」ではなく業務全体を設計する"}],["$","p",null,{"children":"従来の業務システムは、入力と条件が決まれば同じ結果を返す処理を中心に設計できます。一方、生成AIを組み込む場合は、同じ入力でも表現が変わることや、誤った回答が出る可能性を前提に設計します。"}],["$","p",null,{"children":["そのため、AIに何をさせるかだけでなく、",["$","strong",null,{"children":"どのデータを参照するか、どこまで自動実行するか、誰が確認するか、失敗時にどう戻すか"}],"までがシステム要件になります。"]}]]}],["$","section",null,{"id":"use-cases","children":[["$","p",null,{"className":"insightSectionNo","children":"02 — USE CASES"}],["$","h2",null,{"children":"業務システムへ組み込みやすい主なパターン"}],["$","div",null,{"className":"insightCards","children":["$L6","$L7","$L8"]}]]}],"$L9","$La","$Lb","$Lc","$Ld","$Le","$Lf"]}]]}]]}]}],"$L10","$L11"]
6:["$","div",null,{"children":[["$","h3",null,{"children":"問い合わせ・社内検索"}],["$","p",null,{"children":"社内文書や業務データを参照し、回答候補や関連情報を提示します。参照元と権限設計が重要です。"}]]}]
7:["$","div",null,{"children":[["$","h3",null,{"children":"入力・文書作成支援"}],["$","p",null,{"children":"申請文、回答文、報告書などの初稿を生成し、担当者が確認・修正して確定する構成です。"}]]}]
8:["$","div",null,{"children":[["$","h3",null,{"children":"条件整理・判断支援"}],["$","p",null,{"children":"複数の入力から確認事項や候補を整理します。見積、受注、審査前の論点整理などで利用できます。"}]]}]
9:["$","section",null,{"id":"architecture","children":[["$","p",null,{"className":"insightSectionNo","children":"03 — ARCHITECTURE"}],["$","h2",null,{"children":"AIシステム開発で設計する6つの要素"}],["$","ol",null,{"children":[["$","li",null,{"children":[["$","strong",null,{"children":"業務フロー："}],"AIを呼び出す前後で誰が何をするか。"]}],["$","li",null,{"children":[["$","strong",null,{"children":"コンテキスト："}],"AIへ渡す指示、業務ルール、参照情報。"]}],["$","li",null,{"children":[["$","strong",null,{"children":"データ："}],"文書、DB、SaaS、基幹など、正しい参照元。"]}],["$","li",null,{"children":[["$","strong",null,{"children":"権限："}],"利用者ごとに見てよい情報・実行してよい操作。"]}],["$","li",null,{"children":[["$","strong",null,{"children":"ツール連携："}],"検索、API、DB、メール、業務システム等への接続。"]}],["$","li",null,{"children":[["$","strong",null,{"children":"評価・監視："}],"期待する品質、エラー、コスト、利用状況の確認。"]}]]}]]}]
a:["$","section",null,{"id":"integration","children":[["$","p",null,{"className":"insightSectionNo","children":"04 — INTEGRATION"}],["$","h2",null,{"children":"既存システムを捨てずにAIを組み込む"}],["$","p",null,{"children":"AIを使うために既存の基幹・CRM・受注システムをすべて作り直す必要はありません。既存システムを正本として残し、AIが必要な情報を参照したり、候補を作成して既存画面へ返したりする構成も可能です。"}],["$","p",null,{"children":"APIがある場合はAPI連携、ない場合はCSV、DB、バッチ、限定的な画面連携など、既存環境に合わせて接続方法を検討します。重要なのは、AIの都合で業務基盤全体を不要に作り替えないことです。"}]]}]
b:["$","section",null,{"id":"human","children":[["$","p",null,{"className":"insightSectionNo","children":"05 — HUMAN IN THE LOOP"}],["$","h2",null,{"children":"重要な処理は人の確認点を明確にする"}],["$","p",null,{"children":"AIが回答や候補を作ることと、業務上の確定処理を実行することは分けて考えます。顧客への確約、価格決定、契約、支払い、権限変更、重要データ更新などは、業務影響に応じて人の承認を入れます。"}],["$","p",null,{"children":"人が確認する設計は「AIを信用していないから」ではなく、責任の所在を明確にし、例外や誤回答を安全に扱うための業務設計です。"}]]}]
c:["$","section",null,{"id":"evaluation","children":[["$","p",null,{"className":"insightSectionNo","children":"06 — EVALUATION"}],["$","h2",null,{"children":"通常のシステムテストに加えてAI出力を評価する"}],["$","p",null,{"children":"画面遷移やAPIの正常系・異常系だけでなく、代表的な入力に対して必要な情報が含まれるか、禁止事項を守れるか、参照すべきデータを使えているかを確認します。"}],["$","p",null,{"children":"評価用の代表ケースを蓄積し、モデルや指示、参照データを変更したときに品質が悪化していないか確認できるようにします。"}]]}]
d:["$","section",null,{"id":"operations","children":[["$","p",null,{"className":"insightSectionNo","children":"07 — OPERATIONS"}],["$","h2",null,{"children":"リリース後もモデル・コスト・品質を運用する"}],["$","p",null,{"children":"AIシステムはリリースして終わりではありません。利用量、失敗例、回答品質、モデル変更、外部サービスの仕様変更、権限やデータ更新を継続して確認します。"}],["$","p",null,{"children":"プロンプトやモデルだけを保守対象にせず、業務フロー、連携先、評価ケース、監視までを一つの運用対象として管理します。"}]]}]
e:["$","section",null,{"id":"vendor","children":[["$","p",null,{"className":"insightSectionNo","children":"08 — BEFORE ORDER"}],["$","h2",null,{"children":"AIシステム開発を発注する前に確認したいこと"}],["$","ul",null,{"children":[["$","li",null,{"children":"AIで解決したい業務課題が定義されているか"}],["$","li",null,{"children":"参照データと正本が分かっているか"}],["$","li",null,{"children":"既存システムとの連携範囲が整理されているか"}],["$","li",null,{"children":"人が確認・承認するポイントが決まっているか"}],["$","li",null,{"children":"AI出力の評価方法と受入条件を決められるか"}],["$","li",null,{"children":"利用開始後の監視・改善まで見積範囲に含まれるか"}]]}],["$","div",null,{"className":"insightCta","children":[["$","h3",null,{"children":"要件が固まっていない段階から相談できます"}],["$","p",null,{"children":"HeadShotでは、業務整理、既存システム連携、AIを使う範囲、人の承認、運用まで含めて設計・開発します。"}],["$","a",null,{"href":"/services/development/","data-ga-event":"insight_to_service","data-ga-location":"ai_system_final","data-ga-service":"development","children":["システム開発を見る ",["$","span",null,{"aria-hidden":"true","children":"→"}]]}]]}]]}]
f:["$","section",null,{"children":[["$","p",null,{"className":"insightSectionNo","children":"RELATED"}],["$","h2",null,{"children":"実装対象がまだ決まっていない場合"}],["$","p",null,{"children":["$","a",null,{"href":"/services/ai-business-diagnosis/","data-ga-event":"insight_to_service","data-ga-location":"ai_system_related","data-ga-service":"ai-business-diagnosis","children":"AI業務診断で優先順位を整理する →"}]}],["$","p",null,{"children":["$","a",null,{"href":"/insights/generative-ai-business-efficiency/","data-ga-event":"insight_view","data-ga-location":"related_insights","data-ga-service":"ai-business-diagnosis","children":"生成AIによる業務効率化の進め方を読む →"}]}]]}]
