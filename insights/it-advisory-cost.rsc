6:[[["$","meta",null,{"charSet":"utf-8"}],[["$","title","0",{"children":"IT顧問の費用相場は？料金の決まり方と月額契約で確認すべきポイント｜株式会社HeadShot"}],["$","meta","1",{"name":"description","content":"IT顧問の費用は、相談頻度、支援範囲、実務への関与度によって変わります。月額契約とスポット契約の違い、料金を見るときの比較ポイント、中小企業が契約前に確認したい項目を実務目線で解説します。"}],["$","meta","2",{"name":"robots","content":"index, follow"}],["$","meta","3",{"property":"og:title","content":"IT顧問の費用相場は？料金の決まり方と月額契約で確認すべきポイント"}],["$","meta","4",{"property":"og:description","content":"IT顧問の月額・スポット料金を比較するときに、金額だけでなく支援範囲と関与度まで揃えて確認するポイントを解説します。"}],["$","meta","5",{"property":"og:url","content":"https://headshot.co.jp/insights/it-advisory-cost/"}],["$","meta","6",{"property":"og:site_name","content":"株式会社HeadShot"}],["$","meta","7",{"property":"og:type","content":"article"}],["$","meta","8",{"name":"twitter:card","content":"summary"}],["$","meta","9",{"name":"twitter:title","content":"IT顧問の費用相場は？料金の決まり方と月額契約で確認すべきポイント"}],["$","meta","10",{"name":"twitter:description","content":"IT顧問の月額・スポット料金を比較するときに、金額だけでなく支援範囲と関与度まで揃えて確認するポイントを解説します。"}],["$","link","11",{"rel":"shortcut icon","href":"https://headshot.co.jp/favicon.svg"}],["$","link","12",{"rel":"icon","href":"https://headshot.co.jp/favicon.svg"}],["$","link","13",{"rel":"canonical","href":"https://headshot.co.jp/insights/it-advisory-cost/"}],["$","meta","14",{"name":"codex-preview","content":"development"}]],[["$","meta","0",{"name":"viewport","content":"width=device-width, initial-scale=1"}]]],["$","$L8",null,{"segmentMap":{"children":["insights","it-advisory-cost"]},"children":["$","$L9",null,{"id":"layout:/","parallelSlots":"$undefined","children":["$","$La",null,{"children":["$","$L8",null,{"segmentMap":{"children":[]},"children":["$","$L9",null,{"id":"page:/insights/it-advisory-cost/"}]}]}]}]}]]
