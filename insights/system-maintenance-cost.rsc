"$","span",null,{"aria-hidden":"true","children":"→"}]]}]]}]]}],["$","main",null,{"className":"insightPage","children":["$","article",null,{"children":[["$","header",null,{"className":"insightHero","children":[["$","div",null,{"className":"insightBreadcrumb","aria-label":"パンくず","children":[["$","a",null,{"href":"/","children":"トップ"}],["$","span",null,{"aria-hidden":"true","children":"/"}],["$","a",null,{"href":"/insights/","children":"お役立ち情報"}],["$","span",null,{"aria-hidden":"true","children":"/"}],["$","span",null,{"children":"システム保守費用の相場・見直し"}]]}],["$","p",null,{"className":"insightEyebrow","children":"INSIGHT — SYSTEM MAINTENANCE"}],["$","h1",null,{"children":["システム保守費用の相場は？",["$","br",null,{}],"月額料金の内訳と保守契約を見直すポイント"]}],["$","p",null,{"className":"insightLead","children":"システム保守の見積を見ると、同じような規模でも月額料金に大きな差が出ることがあります。 その理由は、監視だけなのか、障害時の調査・復旧、バックアップ、セキュリティ更新、小規模改修まで含むのかで支援範囲が変わるためです。 ここでは、公開されている料金目安を参考にしながら、保守費用と契約内容を見直すときに確認したい項目を整理します。"}],["$","div",null,{"className":"insightMeta","children":[["$","time",null,{"dateTime":"2026-08-20","children":"2026.08.20"}],["$","span",null,{"children":"株式会社HeadShot"}]]}]]}],["$","div",null,{"className":"insightLayout","children":[["$","aside",null,{"className":"insightToc","aria-label":"目次","children":[["$","p",null,{"children":"CONTENTS"}],["$","ol",null,{"children":[["$","li",null,{"children":["$","a",null,{"href":"#cost","children":"費用の決まり方"}]}],["$","li",null,{"children":["$","a",null,{"href":"#scope","children":"保守費用の主な内訳"}]}],["$","li",null,{"children":["$","a",null,{"href":"#market","children":"公開情報で見る費用相場"}]}],["$","li",null,{"children":["$","a",null,{"href":"#factors","children":"料金が変わるポイント"}]}],["$","li",null,{"children":["$","a",null,{"href":"#check","children":"保守契約の見直し"}]}],["$","li",null,{"children":["$","a",null,{"href":"#switch","children":"保守会社を変更する場合"}]}],["$","li",null,{"children":["$","a",null,{"href":"#headshot","children":"HeadShotの保守・改善"}]}],["$","li",null,{"children":["$","a",null,{"href":"#start","children":"相談の始め方"}]}]]}]]}],["$","div",null,{"className":"insightBody","children":[["$","section",null,{"id":"cost","children":[["$","p",null,{"className":"insightSectionNo","children":"01 — COST"}],["$","h2",null,{"children":"システム保守費用は「対応範囲」と「必要な体制」で変わる"}],["$","p",null,{"children":"保守費用を比較するときに最初に確認したいのは、月額そのものではなく、その金額で何を依頼できるかです。 たとえば、異常を検知して連絡するだけの監視と、障害原因の調査から復旧まで行う保守では、必要な体制も工数も異なります。"}],["$","p",null,{"children":["また、平日日中だけの対応か、夜間や休日も含むのか、軽微な改修を月額内で扱うのか、別途見積にするのかでも料金は変わります。 そのため、","$Lb","を揃えて比較することが重要です。"]}]]}],"$Lc","$Ld","$Le","$Lf","$L10","$L11","$L12","$L13","$L14"]}]]}],"$L15"]}]}],"$L16","$L17"]
b:["$","strong",null,{"children":"「月額いくら」ではなく「その月額に何が含まれ、どこから別料金になるか」"}]
c:["$","section",null,{"id":"scope","children":[["$","p",null,{"className":"insightSectionNo","children":"02 — SCOPE"}],["$","h2",null,{"children":"システム保守費用に含まれる主な作業"}],["$","div",null,{"className":"insightCards","children":[["$","div",null,{"children":[["$","h3",null,{"children":"障害・問い合わせ対応"}],["$","p",null,{"children":"エラーや不具合の事象確認、ログ調査、原因切り分け、復旧対応など。どこまでが月額内かを確認します。"}]]}],["$","div",null,{"children":[["$","h3",null,{"children":"監視・ログ確認"}],["$","p",null,{"children":"サーバーやアプリケーションの稼働状況を確認します。検知と通知だけか、一次対応まで含むかで内容が変わります。"}]]}],["$","div",null,{"children":[["$","h3",null,{"children":"バックアップ"}],["$","p",null,{"children":"バックアップの取得だけでなく、保存期間、復元手順、定期的な確認まで含むかを見ます。"}]]}],["$","div",null,{"children":[["$","h3",null,{"children":"更新・セキュリティ対応"}],["$","p",null,{"children":"OS、ミドルウェア、フレームワーク、ライブラリなどの更新調査や適用をどこまで行うか確認します。"}]]}],["$","div",null,{"children":[["$","h3",null,{"children":"仕様変更・小規模改修"}],["$","p",null,{"children":"画面項目の変更や小さな業務改善を月額内で行うのか、都度見積にするのかを明確にします。"}]]}],["$","div",null,{"children":[["$","h3",null,{"children":"運用資料・報告"}],["$","p",null,{"children":"作業履歴、構成情報、運用手順、問い合わせ記録などを更新し、属人化を減らすための管理も保守の一部です。"}]]}]]}]]}]
d:["$","section",null,{"id":"market","children":[["$","p",null,{"className":"insightSectionNo","children":"03 — MARKET"}],["$","h2",null,{"children":"公開情報で見るシステム保守費用の相場"}],["$","p",null,{"children":"2026年8月20日時点で確認できる公開情報でも、システム保守の月額目安には幅があります。 これは、対象とするシステムの規模だけでなく、監視体制、障害対応、対応時間帯、改修の有無などの条件が異なるためです。"}],["$","div",null,{"className":"insightCards","children":[["$","div",null,{"children":[["$","h3",null,{"children":"みんなシステムズ"}],["$","p",null,{"children":"中小企業向けWebシステムの参考レンジとして、小規模は月3万〜10万円、中規模は月10万〜30万円、大規模は月30万〜100万円以上としています。"}],["$","p",null,{"children":["$","a",null,{"href":"https://minna-systems.co.jp/column/web-system-maintenance-cost-sme/","target":"_blank","rel":"noreferrer","children":"出典を確認する →"}]}]]}],["$","div",null,{"children":[["$","h3",null,{"children":"FUNBREW"}],["$","p",null,{"children":"小規模システムは月3万〜10万円、中規模は月10万〜30万円、大規模は月30万円以上という目安を公開しています。"}],["$","p",null,{"children":["$","a",null,{"href":"https://funbrew.tech/blog/system-maintenance-cost-guide","target":"_blank","rel":"noreferrer","children":"出典を確認する →"}]}]]}],["$","div",null,{"children":[["$","h3",null,{"children":"DEHA"}],["$","p",null,{"children":"月額固定型の例として、小規模は月5万〜15万円、中規模は月20万〜50万円、大規模は月100万円〜数百万円という目安を紹介しています。"}],["$","p",null,{"children":["$","a",null,{"href":"https://deha.co.jp/magazine/systemmaintenance-cost/","target":"_blank","rel":"noreferrer","children":"出典を確認する →"}]}]]}]]}],["$","p",null,{"children":"これらは各社が公開している参考情報であり、HeadShotの料金表ではありません。 同じ「小規模」「中規模」でも定義や契約範囲は異なるため、単一の相場を正解として扱わず、見積に含まれる内容と一緒に確認する必要があります。"}]]}]
e:["$","section",null,{"id":"factors","children":[["$","p",null,{"className":"insightSectionNo","children":"04 — FACTORS"}],["$","h2",null,{"children":"保守料金が変わる6つのポイント"}],["$","h3",null,{"children":"1. システムの規模と複雑さ"}],["$","p",null,{"children":"画面数や利用者数だけでなく、外部サービス連携、バッチ処理、データ量、サーバー構成などが増えるほど確認対象が広がります。"}],["$","h3",null,{"children":"2. 対応時間帯とサービスレベル"}],["$","p",null,{"children":"平日日中のみか、夜間・休日も対象か、障害発生時にどの程度の初動時間を求めるかで必要な体制が変わります。"}],["$","h3",null,{"children":"3. 監視・バックアップの範囲"}],["$","p",null,{"children":"死活監視だけか、性能やログまで見るか、バックアップの復元確認まで行うかによって作業量は異なります。"}],["$","h3",null,{"children":"4. 障害対応の範囲"}],["$","p",null,{"children":"原因調査までか、アプリケーション修正やインフラ対応、外部ベンダーとの調整まで含むかを確認します。"}],["$","h3",null,{"children":"5. 軽微な改修を含むか"}],["$","p",null,{"children":"毎月一定時間の改善作業を含む契約と、障害対応だけを固定費にして改修は別途見積とする契約では、月額の考え方が変わります。"}],["$","h3",null,{"children":"6. ドキュメントと属人化の状態"}],["$","p",null,{"children":"設計書や運用手順が不足し、特定担当者しか分からない状態では、保守開始前の調査や情報整理に時間が必要になることがあります。"}]]}]
f:["$","section",null,{"id":"check","children":[["$","p",null,{"className":"insightSectionNo","children":"05 — CHECK"}],["$","h2",null,{"children":"保守契約を見直すときのチェック項目"}],["$","ul",null,{"className":"insightChecklist","children":[["$","li",null,{"children":"現在の月額に含まれる作業を具体的に説明できるか"}],["$","li",null,{"children":"実際に利用していない対応や体制へ費用を払っていないか"}],["$","li",null,{"children":"障害時の一次切り分け、原因調査、復旧の責任範囲が明確か"}],["$","li",null,{"children":"監視、バックアップ、更新作業の頻度と担当が決まっているか"}],["$","li",null,{"children":"軽微な改修と追加見積の境界が明確か"}],["$","li",null,{"children":"契約期間、更新、解約条件を確認できているか"}],["$","li",null,{"children":"ソースコード、サーバー、クラウド、ドメインなどの管理主体が把握できているか"}]]}],["$","p",null,{"children":"「毎月費用を払っているが何をしているのか分からない」「小さな修正でも毎回別料金になる」と感じる場合は、まず契約書と過去の対応履歴を並べ、契約内容と実際の利用状況が合っているかを確認すると整理しやすくなります。"}],["$","p",null,{"children":["契約やベンダー提案そのものの妥当性を第三者の立場で確認したい場合は、",["$","a",null,{"href":"/services/it-advisory/","data-ga-event":"insight_to_service","data-ga-location":"maintenance_cost_body","data-ga-service":"it-advisory","children":"IT顧問"}],"での見積・契約内容の整理も選択肢です。"]}]]}]
10:["$","section",null,{"id":"switch","children":[["$","p",null,{"className":"insightSectionNo","children":"06 — SWITCH"}],["$","h2",null,{"children":"保守会社を変更するときに先に確認したいこと"}],["$","p",null,{"children":"保守会社を変える場合は、料金比較より先に「新しい会社が保守を開始できる状態か」を確認する必要があります。 公開されている引き継ぎガイドでも、ソースコードの権利や入手可否、アクセス権限、現行業者から受け取る情報、移行期間などが重要な確認項目として挙げられています。"}],["$","p",null,{"children":["$","a",null,{"href":"https://www.randynetwork.com/blog/system-maintenance-vendor-transfer-checklist/","target":"_blank","rel":"noreferrer","children":"保守会社変更時の参考情報を確認する →"}]}],["$","ul",null,{"className":"insightChecklist","children":[["$","li",null,{"children":"ソースコードとバージョン管理リポジトリ"}],["$","li",null,{"children":"設計書、構成図、運用手順、問い合わせ履歴"}],["$","li",null,{"children":"サーバー、クラウド、ドメイン、DNSなどの管理権限"}],["$","li",null,{"children":"データベース、バックアップ、ログの場所とアクセス方法"}],["$","li",null,{"children":"外部サービス、ライセンス、API等の契約主体"}],["$","li",null,{"children":"現行保守会社との契約終了日と引き継ぎ可能期間"}]]}],["$","p",null,{"children":"資料が不足していても直ちに引き継げないとは限りません。ソースコード、設定、ログ、現担当者へのヒアリングなどから必要情報を整理し、調査から保守開始までを段階的に進める方法があります。"}]]}]
11:["$","section",null,{"id":"headshot","children":[["$","p",null,{"className":"insightSectionNo","children":"07 — HEADSHOT"}],["$","h2",null,{"children":"HeadShotのシステム保守・改善は月5万円から"}],["$","p",null,{"children":["HeadShotでは、既存システムの保守・改善を",["$","strong",null,{"children":"月5万円から"}],"支援しています。 現在公開している主な支援内容は、保守引き継ぎ、障害・問い合わせ対応、仕様変更・小規模改修、運用の見える化です。"]}],["$","p",null,{"children":"他社が開発したシステムについても、技術構成や契約条件を確認したうえで対応可能範囲を整理します。 設計書が古い、または不足している場合も、ソースコード、設定、ログ、運用状況などを確認しながら必要情報を整理します。"}],["$","p",null,{"children":["「月5万円〜」はHeadShot自身の公開価格であり、前述した市場一般の参考レンジとは別の情報です。 詳細は",["$","a",null,{"href":"/services/maintenance/","data-ga-event":"insight_to_service","data-ga-location":"maintenance_cost_body","data-ga-service":"maintenance","children":"システム保守・改善サービスページ"}],"をご覧ください。"]}]]}]
12:["$","section",null,{"id":"start","children":[["$","p",null,{"className":"insightSectionNo","children":"08 — START"}],["$","h2",null,{"children":"「保守費が妥当かわからない」段階から相談できる"}],["$","p",null,{"children":"いきなり保守会社を変更する必要はありません。現在の契約、システム構成、月々の対応内容を確認し、費用と支援範囲が合っているかを整理するところから始められます。"}],["$","p",null,{"children":["保守契約だけでなく、システム全体のリスクや更改の必要性まで一度整理したい場合は、",["$","a",null,{"href":"/services/it-diagnosis/","data-ga-event":"insight_to_service","data-ga-location":"maintenance_cost_body","data-ga-service":"it-diagnosis","children":"スポットIT診断"}],"も選択肢です。"]}]]}]
13:["$","section",null,{"className":"insightFaq","aria-labelledby":"faq-heading","children":[["$","p",null,{"className":"insightSectionNo","children":"FAQ"}],["$","h2",null,{"id":"faq-heading","children":"よくあるご質問"}],["$","details",null,{"children":[["$","summary",null,{"children":"システム保守費用は月額だけで比較できますか？"}],["$","p",null,{"children":"月額だけでは比較しにくいため、監視、障害対応、バックアップ、更新、改修、対応時間帯、追加費用条件など、料金に含まれる範囲を揃えて確認することが重要です。"}]]}],["$","details",null,{"children":[["$","summary",null,{"children":"他社が開発したシステムでも保守会社を変更できますか？"}],["$","p",null,{"children":"技術構成、契約条件、ソースコードや環境へのアクセス可否を確認して判断します。引き継ぎ資料が不足している場合は、現状調査から始める方法もあります。"}]]}],["$","details",null,{"children":[["$","summary",null,{"children":"HeadShotの保守・改善は何を支援しますか？"}],["$","p",null,{"children":"公開している主な支援内容は、保守引き継ぎ、障害・問い合わせ対応、仕様変更・小規模改修、運用の見える化です。具体的な範囲は対象システムと課題を確認して整理します。"}]]}]]}]
