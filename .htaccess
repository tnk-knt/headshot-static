# HeadShot static-site delivery optimizations for Apache.
# All directives are guarded so deployment remains safe when an optional module is unavailable.

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/ld+json application/xml image/svg+xml
</IfModule>

<IfModule mod_setenvif.c>
  SetEnvIf Request_URI "^/assets/" headshot_immutable_asset=1
</IfModule>

<IfModule mod_headers.c>
  # Vinext/Vite asset filenames are content-hashed, so they are safe to cache for one year.
  Header always set Cache-Control "public, max-age=31536000, immutable" env=headshot_immutable_asset

  # Stable public images can be cached aggressively while still allowing periodic refresh.
  <FilesMatch "\.(?:png|jpe?g|webp|avif|svg|ico)$">
    Header set Cache-Control "public, max-age=2592000, stale-while-revalidate=86400"
  </FilesMatch>
</IfModule>
